APP_NAME=FollowUP
APP_ENV=production
APP_KEY=replace-with-random-app-key
APP_DEBUG=false
APP_URL=http://localhost:8080
PORT=8080
APP_WORKING_TIMEZONE=Asia/Baghdad
APP_SWAGGER_ENABLED=true

# Database: mysql (production) or sqlite (local/testing)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aiicom_followup
DB_USERNAME=root
DB_PASSWORD=

# CORS & proxies
FRONTEND_ALLOWED_ORIGINS=https://follow.ama8.uk,http://localhost:3000
FRONTEND_ALLOWED_ORIGIN_PATTERNS=
TRUSTED_PROXY_CIDRS=

# Storage root for attachments and avatars
STORAGE_ROOT=./storage/app

# Webhooks & Web Push VAPID
GITHUB_WEBHOOK_SECRET=
VAPID_SUBJECT=mailto:support@ama8.uk
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Rate limiting & optional built-in daily reminder scheduler
RATE_LIMIT_LOGIN=30
RATE_LIMIT_API=300
ENABLE_DAILY_SCHEDULER=false
